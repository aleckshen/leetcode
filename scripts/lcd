#!/usr/bin/env python3
"""Create today's LeetCode daily solution file from template.md.

Fetches the active daily challenge and writes
`<YYYY>/<YYYY-MM>/<YYYY-MM-DD>/<id>.md` with the frontmatter filled in.

Run from the repo root:  scripts/lcd
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = REPO_ROOT / "template.md"

QUERY = """
query {
  activeDailyCodingChallengeQuestion {
    date
    link
    question { questionFrontendId title difficulty }
  }
}
"""


def fetch_daily() -> dict:
    # Shell out to curl: python.org builds on macOS often lack SSL certs for urllib.
    out = subprocess.run(
        [
            "curl", "-sSf", "https://leetcode.com/graphql",
            "-H", "Content-Type: application/json",
            "-H", "Referer: https://leetcode.com",
            "-d", json.dumps({"query": QUERY}),
        ],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out)["data"]["activeDailyCodingChallengeQuestion"]


def format_title(title: str) -> str:
    # "Number of Unique XOR Triplets II" -> "Number-Of-Unique-XOR-Triplets-II"
    return "-".join(w[:1].upper() + w[1:] for w in title.split())


def main() -> int:
    daily = fetch_daily()
    q = daily["question"]
    date = daily["date"]  # challenge date (UTC), e.g. "2026-09-28"
    qid = q["questionFrontendId"]
    link = f"https://leetcode.com{daily['link']}description/"
    subprocess.run(["open", "-a", "Google Chrome", link], check=True)

    out_dir = REPO_ROOT / date[:4] / date[:7] / date
    out_file = out_dir / f"{qid}.md"
    if out_file.exists():
        print(f"Already exists: {out_file.relative_to(REPO_ROOT)}")
        return 1

    fields = {
        "title": format_title(q["title"]),
        "question_id": qid,
        "question_link": link,
        "difficulty": q["difficulty"],
    }
    text = TEMPLATE.read_text(encoding="utf-8")
    for key, value in fields.items():
        text = text.replace(f'{key}: ""', f'{key}: "{value}"', 1)

    out_dir.mkdir(parents=True, exist_ok=True)
    out_file.write_text(text, encoding="utf-8")
    print(f"Created {out_file.relative_to(REPO_ROOT)}  ({qid}. {q['title']} - {q['difficulty']})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
